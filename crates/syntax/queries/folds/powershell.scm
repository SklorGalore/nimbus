; Fold regions for PowerShell: braced blocks, parameter blocks, hash
; tables, here-strings and block comments.
[
  (function_statement)
  (param_block)
  (statement_block)
  (script_block_expression)
  (hash_literal_expression)
  (array_expression)
  (class_statement)
  (class_method_definition)
  (enum_statement)
  (switch_body)
  (string_literal)
  (comment)
] @fold

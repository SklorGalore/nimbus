; Fold regions for Rust (M14, for M13's folds): items with a body,
; blocks, control flow and match arms.
[
  (function_item)
  (impl_item)
  (trait_item)
  (mod_item)
  (struct_item)
  (enum_item)
  (union_item)
  (block)
  (if_expression)
  (loop_expression)
  (while_expression)
  (for_expression)
  (closure_expression)
  (match_expression)
  (match_arm)
  (macro_invocation)
  (block_comment)
] @fold
